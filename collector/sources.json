{
  "themes": [
    {
      "id": "context",
      "name": "上下文与记忆",
      "question": "长任务如何保持正确的上下文？",
      "description": "压缩、外部记忆、状态交接、检索与渐进披露。关注信息留存质量，而不只是窗口长度。"
    },
    {
      "id": "orchestration",
      "name": "执行与编排",
      "question": "什么时候该拆分，什么时候该简化？",
      "description": "Agent loop、子代理、并行执行与长任务恢复。用消融实验检验每个编排层是否必要。"
    },
    {
      "id": "tools",
      "name": "工具与协议",
      "question": "怎样让能力易于发现、组合和调用？",
      "description": "工具接口、插件生命周期、MCP、Skills 与 Agent-Computer Interface。"
    },
    {
      "id": "evaluation",
      "name": "评测与反馈",
      "question": "怎样知道 harness 真的变好了？",
      "description": "Trace、失败归因、验证闭环、基准与回归。将模型、任务和成本纳入对照。"
    },
    {
      "id": "runtime",
      "name": "运行时与隔离",
      "question": "如何让长任务可靠、安全地运行？",
      "description": "沙箱、权限边界、持久会话、执行环境和故障恢复。"
    },
    {
      "id": "evolution",
      "name": "自改进与适配",
      "question": "哪些设计正在被更强的模型淘汰？",
      "description": "模型适配、harness 消融、自动优化与可观测性驱动的演化。"
    }
  ],
